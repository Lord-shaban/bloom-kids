# Cloudflare Pages headers

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

# ملحوظة مهمة: Cloudflare Pages بيشيل .html من الروابط
# يعني /admin.html بيعمل redirect لـ /admin — فلازم نكتب الاتنين،
# وإلا الهيدرز تتطبّق على الـ redirect بس والصفحة الحقيقية تفضل من غير حماية.

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# الألعاب بقت جزء من الموقع (٢ أغسطس ٢٠٢٦) — كانت مخفية قبل كده
# بـ X-Robots-Tag هنا + noindex في الصفحة نفسها، والاتنين اتشالوا.
# لو ضفت لعبة جديدة، متحطّهاش هنا إلا لو عايزها تفضل مخفية.

# صفحة المدرّس: خاصة تماماً — مفيش لينك ليها من أي مكان
/host.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/host
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# صفحة السيشن المباشرة: ملهاش لازمة في نتايج البحث
/meeting.html
  X-Robots-Tag: noindex, nofollow

/meeting
  X-Robots-Tag: noindex, nofollow
